<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\WeddingInvitation.Api.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="Hosting__Urls" value="" />
          <!--
            如果 IIS 服务器无法访问远程取串接口，请在服务器上改用本地连接串兜底：
            1. 设置 PostgreSql__UseRemote=false
            2. 设置 PostgreSql__ConnectionString=两层 Base64 编码后的 PostgreSQL 连接串
            不建议把明文数据库密码写入 web.config。
          -->
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
